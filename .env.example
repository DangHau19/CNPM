# Sao chép file này thành ".env" (cùng thư mục với docker-compose.yml) rồi sửa nếu muốn. File .env không được đưa lên GitHub.
MYSQL_ROOT_PASSWORD=root
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
# true (mặc định): trang admin chỉ vào được từ máy chạy Docker; link công khai (tunnel) không vào được /admin
ADMIN_LOCAL_ONLY=true
# Khóa ký đăng nhập admin, tối thiểu 32 ký tự
JWT_KEY=change-me-in-production-at-least-32-characters!!
